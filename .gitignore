# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# credential material - this repository is public, and a secret committed once
# stays reachable from the commit that introduced it even after it is deleted
*.pem
*.key
*.pfx
*.p12
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
.git-credentials
.npmrc
.netrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# typescript build cache
tsconfig.tsbuildinfo

# production release slots (alternating; never committed)
/.next-release-a/
/.next-release-b/

# safe-deploy logs
/deploy/logs/

# playwright output (the harnesses write screenshots into qa/shots, which IS
# tracked on purpose; these two directories are transient run artefacts)
/test-results/
/playwright-report/
